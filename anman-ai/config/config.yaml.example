# =====================================================================
# anman-ai Configuration File Example
# =====================================================================
# このファイルをコピーして config.yaml を作成し、設定値を調整してください。

# ---------------------------------------------------------------------
# 1. サーバー設定 (人狼CGIサーバーへの接続設定)
# ---------------------------------------------------------------------
server:
  # 接続対象の人狼CGIサーバーのURL
  url: "https://lolipop.gunjobiyori.com/aiwolf"
  
  # 参戦する村のIDを指定します。
  # 0を指定（または省略）した場合、新規の募集中（点呼中）の村を自動で巡回監視し、エントリーします。
  vid: 0

  # 村に設定されている入村用パスワード（パスワード保護された村に入る場合に指定）
  # pass: "village_pass"

  # 感想戦（エピローグ）フェーズでチャットを行い、クライアントを終了するまでの待機時間（秒数。デフォルトは3600秒/1時間）
  epilogue_timeout: 3600

# ---------------------------------------------------------------------
# 2. ユーザー認証設定 (ボット用のアカウント情報)
# ---------------------------------------------------------------------
user:
  # CGIサーバーにログインするためのユーザーID
  userid: "YOUR_USER_ID"
  
  # CGIサーバーにログインするためのパスワード
  password: "YOUR_PASSWORD"

# ---------------------------------------------------------------------
# 3. メインLLM設定
# ---------------------------------------------------------------------
# 選択されたLLMプロバイダの設定です。
# WebUIから保存すると、llm_providers の選択したプリセットがここにコピーされます。
llm:
  provider: "gemini"
  api_key: "AIzaSyYourGeminiApiKeyHere"  # あなたのGemini APIキー (※環境変数 GEMINI_API_KEY または ANMAN_GEMINI_API_KEY でも指定可能)
  model: "gemini-2.5-flash"              # 選択可能なモデル: gemini-2.5-flash, gemini-2.5-pro, gemini-3.5-flash など
  compact_prompt: true                   # true: サマリー+差分ログのみ送信（コンテキスト節約）/ false: 全チャットログ送信
  talk_interval_reactive: 10             # 反応発言の最小間隔（秒）。他人の発言にすぐ喋りすぎるのを防ぐ
  talk_interval_active: 60               # 能動発言の最小間隔（秒）。誰も喋っていないときに喋り出す間隔
  auto_adjust_talk_interval: true        # true: 村の昼の長さ(period)に比例して発言間隔を自動調整し、長期村での連投を防ぐ
  budget_mode: "normal"                  # 発言頻度の予算モード ("low_cost": 発言間隔を2.5倍に延ばしトークン節約 / "normal": 等倍 / "max": 0.5倍に短縮し積極的に喋る)
  anchor_resolution: true                # true: チャットログ内の >>N アンカーを参照先の発言内容に展開してLLMに渡す（文脈理解向上、トークン増大）
                                         # false: >>N を原文のまま渡す（トークン節約、LLMはアンカー先を参照不可）

# ---------------------------------------------------------------------
# 各プロバイダのプリセット設定 (WebUI切り替え用)
# ---------------------------------------------------------------------
llm_providers:
  gemini:
    provider: "gemini"
    api_key: "AIzaSyYourGeminiApiKeyHere"
    model: "gemini-2.5-flash"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true
  ollama:
    provider: "ollama"
    api_key: "ollama"
    base_url: "http://localhost:11434"
    model: "gemma4"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true
  openai_compat:
    provider: "openai_compat"
    api_key: "sk-proj-YourOpenAIApiKey"
    base_url: "https://api.openai.com/v1"
    model: "gpt-4o-mini"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true

# ---------------------------------------------------------------------
# 4. フォールバックLLM設定 (オプション)
# ---------------------------------------------------------------------
# メインのLLMが一時的なレート制限やエラー等で失敗した場合の代替接続先を定義できます。
# メインLLMと同様の項目を定義します。設定しない場合はフォールバックされません。
llm_fallback:
  provider: "ollama"
  api_key: "ollama"
  base_url: "http://localhost:11434"
  model: "gemma4"
  compact_prompt: true

# ---------------------------------------------------------------------
# 5. ローカルログ設定 (ローカルファイルへの出力ログ設定)
# ---------------------------------------------------------------------
log:
  # ログファイルがこのサイズ（MB）を超えると、自動的にローテーション（分割）します。
  max_size_mb: 10

  # ローテーション後に保持するログファイルの世代数
  keep_files: 5

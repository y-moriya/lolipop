#!/usr/bin/env ruby
# -*- coding: utf-8 -*-

# lib ディレクトリをロードパスに追加
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

def print_usage
  puts "Usage: #{$0} [config_path] [--update] [--cli]"
  puts "Default config_path is config/config.yaml"
  puts "Use --cli to launch in console mode (default is WebUI mode)."
  puts "Use --update to perform self-update to the latest version."
end

# OCRANの実行パス解決
exe_dir = if ENV['OCRAN_EXECUTABLE']
  File.dirname(ENV['OCRAN_EXECUTABLE'])
elsif defined?(OCRAN_EXECUTABLE)
  File.dirname(OCRAN_EXECUTABLE)
else
  File.expand_path('..', __dir__)
end

no_web = ARGV.include?('--no-web') || ARGV.include?('--cli')
clean_argv = ARGV.reject { |arg| arg == '--no-web' || arg == '--cli' }

if ARGV.include?('--update')
  require 'updater'
  AnmanAI::Updater.run(exe_dir)
  exit 0
end

internal_root_dir = File.expand_path('..', __dir__)
config_path = clean_argv[0] || File.join(exe_dir, 'config', 'config.yaml')

# OCRANビルド用: もし config.yaml が存在しない場合は config.yaml.example を代用して依存パッケージのロードを通す
if defined?(Ocran) && !File.exist?(config_path)
  example_path = File.join(exe_dir, 'config', 'config.yaml.example')
  config_path = example_path if File.exist?(example_path)
end

unless File.exist?(config_path)
  puts "Error: Config file not found at #{config_path}"
  print_usage
  exit 1
end

# ログ設定を反映するため先に config をロード
require 'stringio'
require 'yaml'
begin
  config = YAML.load_file(config_path)
  config = {} unless config.is_a?(Hash)
rescue => e
  puts "===================================================="
  puts "[Fatal Error] Failed to parse config file: #{e.message}"
  puts "Please check your configuration file: #{config_path}"
  puts "===================================================="
  exit 1
end

if config['llm_config']
  config_dir = File.dirname(config_path)
  llm_config_path = File.expand_path(config['llm_config'], config_dir)
  if File.exist?(llm_config_path)
    begin
      llm_config = YAML.load_file(llm_config_path)
      llm_config = {} unless llm_config.is_a?(Hash)
      config['llm'] = llm_config['llm'] if llm_config['llm']
      config['llm_fallback'] = llm_config['llm_fallback'] if llm_config['llm_fallback']
    rescue => e
      puts "[System WARNING] Failed to parse LLM config at #{llm_config_path}: #{e.message}"
    end
  else
    puts "[System WARNING] Referenced LLM config file not found: #{llm_config_path}"
  end
end

# Loggerのセットアップ
require 'log_manager'
AnmanAI.setup_logger(exe_dir, config)

require 'client'
require 'anman-ai/version'
require 'web_server'

# OCRANビルドの依存関係ロード用：ビルド中であれば即終了
if defined?(Ocran)
  puts "OCRAN build mode detected. Exiting successfully after dependencies loaded."
  exit 0
end

puts "=== Starting anman-ai Autonomous Werewolf Client ==="
puts "Version:        #{AnmanAI::VERSION}"
puts "Build Time:     #{AnmanAI::BUILD_TIME}"
puts "Root Directory: #{exe_dir}"
puts "Config File:    #{config_path}"
puts "Mode:           #{no_web ? 'Legacy CUI' : 'WebUI (Default)'}"
puts "===================================================="

begin
  client = AnmanAI::Client.new(config_path, exe_dir, internal_root_dir)
  
  if no_web
    puts "[System] Performing connection test to AIWolf server..."
    test_res = client.test_connection
    unless test_res[:success]
      puts "===================================================="
      puts "[Fatal Error] Connection test failed: #{test_res[:error]}"
      puts "Please check your server URL, userid, and password in config."
      puts "===================================================="
      exit 1
    end
    puts "[System] Connection test passed."

    client.login!
    
    vid = client.instance_variable_get(:@vid)
    already_joined = client.find_active_joined_village
    
    if already_joined
      puts "[System] Already joined active village ID: #{client.instance_variable_get(:@vid)}. Resuming gameplay..."
    else
      if vid.nil? || vid == 0
        client.auto_entry_loop!
      else
        client.instance_variable_set(:@vid, vid)
        puts "[System] Target village ID: #{vid}. Checking entry status..."
        entry_ok = false
        30.times do |i|
          if client.entry_to_village!
            entry_ok = true
            break
          end
          puts "  Waiting for village ID #{vid} to be created or available... (#{i+1}/30)"
          sleep 5
        end
        unless entry_ok
          puts "[System] Active entry failed. Falling back to auto-entry monitoring..."
          client.instance_variable_set(:@vid, nil)
          client.auto_entry_loop!
        end
      end
    end
    
    # 実行中のフラグを立ててメインループを走らせる
    client.instance_variable_set(:@running, true)
    client.init_game_state!
    client.start_loop!
  else
    # WebUI モード
    web_server = AnmanAI::WebServer.new(client, exe_dir, internal_root_dir)
    web_server.start
    
    url = "http://127.0.0.1:8064"
    puts "\nWebUI Server started at: #{url}"
    puts "Press Ctrl+C to stop the server."
    
    # 自動で規定のブラウザを開く
    Thread.new do
      sleep 1.0 # サーバーの起動待ち
      begin
        if RUBY_PLATFORM =~ /mswin|mingw|cygwin/
          system("start #{url}")
        elsif RUBY_PLATFORM =~ /darwin/
          system("open #{url}")
        else
          system("xdg-open #{url} > /dev/null 2>&1 &")
        end
      rescue => e
        puts "[System WARNING] Failed to auto-open browser: #{e.message}"
      end
    end
    
    # メインスレッドは WEBrick を監視しながら待機
    begin
      loop do
        sleep 2
      end
    rescue Interrupt
      puts "\n[System] Shutting down WebUI server..."
      client.stop! if client.running
      web_server.stop
      puts "[System] WebUI server stopped. Goodbye!"
      exit 0
    end
  end
rescue Interrupt
  puts "\n[System] Exiting anman-ai. Goodbye!"
  exit 0
rescue => e
  STDERR.puts "\n[Fatal Error] Runtime exception occurred:"
  STDERR.puts "#{e.class}: #{e.message}"
  STDERR.puts e.backtrace.join("\n")
  exit 1
end

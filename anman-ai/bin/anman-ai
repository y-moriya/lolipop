#!/usr/bin/env ruby
# -*- coding: utf-8 -*-

# lib ディレクトリをロードパスに追加
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'client'

def print_usage
  puts "Usage: #{$0} [config_path]"
  puts "Default config_path is config/config.yaml"
end

root_dir = File.expand_path('..', __dir__)
config_path = ARGV[0] || File.join(root_dir, 'config', 'config.yaml')

unless File.exist?(config_path)
  puts "Error: Config file not found at #{config_path}"
  print_usage
  exit 1
end

puts "=== Starting anman-ai Autonomous Werewolf Client ==="
puts "Root Directory: #{root_dir}"
puts "Config File:    #{config_path}"
puts "===================================================="

begin
  client = AnmanAI::Client.new(config_path, root_dir)
  client.login!
  client.init_game_state!
  client.start_loop!
rescue Interrupt
  puts "\n[System] Exiting anman-ai player loop. Goodbye!"
  exit 0
rescue => e
  STDERR.puts "\n[Fatal Error] Runtime exception occurred:"
  STDERR.puts "#{e.class}: #{e.message}"
  STDERR.puts e.backtrace.join("\n")
  exit 1
end

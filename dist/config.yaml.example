server:
  url: "https://wolften.secret.jp"
  vid: 0

user:
  userid: "your_username"      # ← ウルフテンのユーザーID
  password: "your_password"    # ← パスワード

llm:
  provider: "gemini"
  api_key: ""
  model: "gemini-2.5-flash"
  compact_prompt: true
  talk_interval_reactive: 10
  talk_interval_active: 60
  auto_adjust_talk_interval: true
  budget_mode: "normal"
  anchor_resolution: true

# --- 各プロバイダのプリセット設定 (WebUI切り替え用) ---
llm_providers:
  gemini:
    provider: "gemini"
    api_key: ""
    model: "gemini-2.5-flash"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true
  ollama:
    provider: "ollama"
    api_key: "ollama"
    base_url: "http://localhost:11434"
    model: "gemma4"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true
  openai_compat:
    provider: "openai_compat"
    api_key: ""
    base_url: "https://api.openai.com/v1"
    model: "gpt-4o-mini"
    compact_prompt: true
    talk_interval_reactive: 10
    talk_interval_active: 60
    auto_adjust_talk_interval: true
    budget_mode: "normal"
    anchor_resolution: true

# --- フォールバック設定 (任意) ---
# llm_fallback:
#   provider: "ollama"
#   api_key: "ollama"
#   base_url: "http://localhost:11434"
#   model: "gemma4"
#   compact_prompt: true

log:
  max_size_mb: 10    # ローテーション上限（MB）
  keep_files: 5      # 保持世代数

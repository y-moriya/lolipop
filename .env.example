# ロリポップ！ FTP接続設定
# このファイルを .env にコピーして、適切な値を設定してください。
# .env は Git の管理対象から除外（.gitignore に追加）することを強く推奨します。

# FTPホスト名 (例: ftp.lolipop.jp または sub-domain.lolipop.jp)
FTP_HOST=ftp.lolipop.jp

# FTPユーザー名 (例: user.lolipop.jp-xxxxx)
FTP_USER=your_ftp_username

# FTPパスワード
FTP_PASS=your_ftp_password

# ロリポップ側のアップロード先ディレクトリ
# 通常は / か、サブドメイン設定している場合は /public_html などの指定ディレクトリ
FTP_DIR=/
